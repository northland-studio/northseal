<div class="text-center px-2">
  <% if local_assigns[:with_counter] %>
    <% count = CompletedSubmitter.distinct.count(:submission_id) %>
    <% if count > 1 %>
      <%= t('count_documents_signed_with_html', count:) %>
    <% else %>
      <%= t('powered_by') %>
    <% end %>
  <% else %>
    <%= t('powered_by') %>
  <% end %>
  <a href="https://www.docuseal.com" class="underline" target="_blank" rel="noopener"><%= Docuseal.product_name %></a>
  <span>· <%= Docuseal::BRAND_NAME %> 定制</span>
</div>
