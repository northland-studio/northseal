<section class="flex items-center justify-center">
  <div class="py-10 mx-auto max-w-7xl px-4">
    <div class="max-w-2xl mx-auto">
      <div class="text-center">
        <div class="relative flex flex-col items-center">
          <%= render 'shared/logo', width: '112', height: '112' %>
          <h1 class="text-5xl font-bold mt-4 mb-3">
            <%= Docuseal::BRAND_NAME %>
          </h1>
          <p class="text-lg text-gray-600 mb-2"><%= Docuseal::BRAND_TAGLINE %></p>
          <p class="text-sm text-gray-500 mb-8">安全、可靠、可追溯的电子签署平台</p>
          <div class="flex items-center justify-center gap-3">
            <%= link_to t('sign_in'), new_user_session_path, class: 'btn btn-primary btn-lg' %>
          </div>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3 mt-16">
      <div class="card bg-base-200">
        <div class="card-body">
          <h3 class="text-xl font-semibold mb-2">电子签章</h3>
          <p class="text-base text-gray-500">上传 PDF、可视化拖放签章位置，支持模板、多方顺序签署与批量发起。</p>
        </div>
      </div>
      <div class="card bg-base-200">
        <div class="card-body">
          <h3 class="text-xl font-semibold mb-2">安全合规</h3>
          <p class="text-base text-gray-500">自动生成数字签名并支持验签，签署全过程留痕，文件仅存储于工作室自有服务器。</p>
        </div>
      </div>
      <div class="card bg-base-200">
        <div class="card-body">
          <h3 class="text-xl font-semibold mb-2">开放集成</h3>
          <p class="text-base text-gray-500">提供 REST API 与 Webhook，可与工作室内部系统对接，实现合同自动化流转。</p>
        </div>
      </div>
    </div>

    <div class="text-center mt-14 text-sm text-gray-500 space-y-2">
      <div>
        基于开源项目
        <a href="https://www.docuseal.com" class="link" target="_blank" rel="noopener">DocuSeal</a>
        （AGPL-3.0）二次定制 ·
        <a href="<%= Docuseal::BRAND_SOURCE_URL %>" class="link" target="_blank" rel="noopener">本站源码</a>
      </div>
      <div>Powered by DocuSeal · <%= Docuseal::BRAND_NAME %> <%= Docuseal::BRAND_TAGLINE %></div>
    </div>
  </div>
</section>
<%= render 'shared/attribution', with_counter: true %>
